#!/usr/bin/env python

import os
import subprocess

# The tag is only true of this commit. CI submodule checkouts have no tags to read,
# and CI fails if deps/godot-cpp moves without this baseline being updated.
GODOT_CPP_BASELINE_TAG = "10.0.0-rc1"
GODOT_CPP_BASELINE_COMMIT = "58d1de720b8ffe9f8ffcdfe3a85148582cfd2e74"
PROVENANCE_HEADER = "build/generated/nozzle_godot/build_provenance.hpp"

VariantDir("build/nozzle", "deps/nozzle", duplicate=0)


def nozzle_source(path):
    return path.replace("deps/nozzle/", "build/nozzle/", 1)


def read_nozzle_sources(group):
    list_path = "deps/nozzle/sources/{}.txt".format(group)
    with open(list_path) as list_file:
        entries = [line.strip() for line in list_file if line.strip()]
    if not entries:
        raise SystemExit("{} is empty".format(list_path))
    return ["deps/nozzle/" + entry for entry in entries]


def nozzle_sources_for_platform(platform):
    sources = read_nozzle_sources("common")
    if platform in ["macos", "windows", "linux"]:
        sources += read_nozzle_sources(platform)
    return [nozzle_source(source) for source in sources]


def git_output(path, *args):
    return subprocess.check_output(
        ["git", "-C", path] + list(args), stderr=subprocess.DEVNULL, universal_newlines=True
    ).strip()


def dependency_revision(path):
    # Without its own .git, `git -C` would report the parent repo's revision.
    if not os.path.exists(os.path.join(path, ".git")):
        return "unknown", "unknown"
    try:
        sha = git_output(path, "rev-parse", "HEAD")
        dirty = "true" if git_output(path, "status", "--porcelain") else "false"
    except (OSError, subprocess.CalledProcessError):
        return "unknown", "unknown"
    return sha, dirty


def write_provenance_header():
    nozzle_sha, nozzle_dirty = dependency_revision("deps/nozzle")
    godot_cpp_sha, godot_cpp_dirty = dependency_revision("deps/godot-cpp")
    godot_cpp_tag = GODOT_CPP_BASELINE_TAG if godot_cpp_sha == GODOT_CPP_BASELINE_COMMIT else "unknown"
    content = (
        "#pragma once\n\n"
        "// Generated by SConstruct. Do not edit.\n"
        "namespace nozzle_godot_build {\n"
        'constexpr const char *k_nozzle_sha = "' + nozzle_sha + '";\n'
        'constexpr const char *k_nozzle_dirty = "' + nozzle_dirty + '";\n'
        'constexpr const char *k_godot_cpp_sha = "' + godot_cpp_sha + '";\n'
        'constexpr const char *k_godot_cpp_tag = "' + godot_cpp_tag + '";\n'
        'constexpr const char *k_godot_cpp_dirty = "' + godot_cpp_dirty + '";\n'
        "} // namespace nozzle_godot_build\n"
    )
    # Keep the file untouched when nothing changed, so a no-op build stays a no-op.
    if os.path.exists(PROVENANCE_HEADER):
        with open(PROVENANCE_HEADER, newline="") as existing:
            if existing.read() == content:
                return
    os.makedirs(os.path.dirname(PROVENANCE_HEADER), exist_ok=True)
    with open(PROVENANCE_HEADER, "w", newline="") as header:
        header.write(content)


write_provenance_header()

env = SConscript("deps/godot-cpp/SConstruct")
platform = env.get("platform")
env.Append(CPPPATH=["include", "src", "build/generated", "deps/nozzle/include", "deps/nozzle/src", "deps/nozzle/libs/plog/include"])
env.Append(CXXFLAGS=["-std=c++17"] if platform not in ["windows"] else ["/std:c++17"])

if platform == "macos":
    env.Append(CPPDEFINES=["NOZZLE_PLATFORM_MACOS=1", "NOZZLE_HAS_METAL=1"])
    env.Append(LINKFLAGS=["-framework", "Metal", "-framework", "IOSurface", "-framework", "Foundation", "-framework", "Accelerate"])
    env.Append(LIBS=["objc"])
elif platform == "windows":
    env.Append(CPPDEFINES=["NOZZLE_PLATFORM_WINDOWS=1", "NOZZLE_HAS_D3D11=1"])
    env.Append(LIBS=["d3d11", "dxgi", "bcrypt"])
elif platform == "linux":
    env.Append(CPPDEFINES=["NOZZLE_PLATFORM_LINUX=1", "NOZZLE_HAS_DMA_BUF=1"])
    env.ParseConfig("pkg-config --cflags --libs libdrm gbm egl")

sources = Glob("src/*.cpp") + nozzle_sources_for_platform(platform)

if platform == "macos":
    library = env.SharedLibrary(
        "project/bin/libnozzle_godot.{}.{}.framework/libnozzle_godot.{}.{}".format(
            platform, env["target"], platform, env["target"]
        ),
        source=sources,
    )
else:
    library = env.SharedLibrary(
        "project/bin/libnozzle_godot{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
        source=sources,
    )

env.NoCache(library)
Default(library)
